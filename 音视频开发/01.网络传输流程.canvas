{
	"nodes":[
		{"id":"119882ef27a5516e","type":"text","text":"HDMI RX 驱动开始采集 HDMI\n硬件编码器开始编码\n编码后的帧写入 kshm","x":-274,"y":920,"width":332,"height":100,"color":"1"},
		{"id":"e86915a6dddb9093","type":"text","text":"#define HSVC_HND_AUDIO_CTRL_PORT 7001\n\n#define HSVC_HND_AUDIO_DATA_PORT 7002\n\n#define HSVC_HND_VIDEO_CTRL_PORT 7003\n\n#define HSVC_HND_VIDEO_DATA_PORT 7004\n\n\n\nstatic int source_create_data_sockets(struct source_app_ctx *app)\n\n{\n\n    app->video_data_sock = create_data_socket(HSVC_HND_VIDEO_DATA_PORT,\n\n                         app->runtime.transport_mode);\n\n    if (app->video_data_sock < 0) {\n\n        printf(\"Create video_data_sock error\\n\");\n\n        return -1;\n\n    }\n\n  \n\n    app->audio_data_sock = create_data_socket(HSVC_HND_AUDIO_DATA_PORT,\n\n                         app->runtime.transport_mode);\n\n    if (app->audio_data_sock < 0) {\n\n        printf(\"Create audio_data_sock error\\n\");\n\n        close(app->video_data_sock);\n\n        app->video_data_sock = -1;\n\n        return -1;\n\n    }\n\n  \n\n    printf(\"video_data_sock: %d\\n\", app->video_data_sock);\n\n    printf(\"audio_data_sock: %d\\n\", app->audio_data_sock);\n\n    return 0;\n\n}\n\n\nstatic int create_data_socket(int server_port, hsvc_hnd_hdmi_transport_mode_t mode)\n\n{\n\n    int sock;\n\n  \n\n    if (mode == HSVC_HND_HDMI_TRANSPORT_UDP ||\n\n        mode == HSVC_HND_HDMI_TRANSPORT_KCP) {\n\n        sock = hsvc_hnd_transport_socket_create(server_port, 1);\n\n        /* Congestion happens: fail fast and drop frame, avoid latency buildup. */\n\n        set_socket_send_timeout(sock, 50);\n\n        return sock;\n\n    }\n\n  \n\n    (void)server_port;\n\n    sock = hsvc_hnd_transport_socket_create(0, 0);\n\n    /* TCP can block on writev; keep timeout short so current frame is dropped. */\n\n    set_socket_send_timeout(sock, 300);\n\n    return sock;\n\n}\n\n\n","x":234,"y":-627,"width":806,"height":167},
		{"id":"a736117d835caea5","type":"text","text":"如果kshm（驱动和应用之间的共享缓冲区）写的时候没有对象读会怎么样，需要怎么处理","x":200,"y":840,"width":420,"height":80},
		{"id":"f464211114e24645","type":"text","text":"HDMI_RX_SET_VIDEO_DATA_PATH\n设置 bitPerSecond：码率\nintraPicRate：I/IDR 帧间隔\nqpMin / qpMax：QP 范围\nfixedIntraQp：固定 I 帧 QP\nioctl(HDMI_RX_SET_H264_ENC_PARAM)\nioctl(HDMI_RX_SET_H264_SLICE_CFG)\n\n\n\ntypedef struct h264_slice_cfg {\n\n    uint8_t enable_low_latency;   //<! 0: frame output, 1: slice low-latency output\n\n    uint32_t slice_count_per_frame; //<! desired slice count per frame, auto-clamped by resolution\n\n} h264_slice_cfg_t;\n\nHsvcHdmiNetDisplayH264EncParamReq long_gop = {\n\n\t.intraPicRate = intra_pic_rate,\n\n\t.bitPerSecond = startup_bps,\n\n\t.qpMin = 10,\n\n\t.qpMax = 50,\n\n\t.qpHdr = 16,\n\n\t.fixedIntraQp = fixed_intra_qp,\n\n};\n\nsource_h264_apply_param_locked(&app->runtime, &long_gop, false);\n\n  \n\nstatic int source_h264_apply_param_locked(struct source_runtime_state *runtime,\n\n                      const HsvcHdmiNetDisplayH264EncParamReq *req,\n\n                      bool reset_bitrate_window)\n\n{\n\n    struct source_h264_ctrl_state *ctrl = &runtime->h264_ctrl;\n\n    h264_enc_param_t p;\n\n    int ret = 0;\n\n  \n\n    if (req == NULL)\n\n        return -1;\n\n    if (runtime->enc_type != VIDENC_TYPE_H264 || !runtime->rx_fd || *runtime->rx_fd < 0) {\n\n        printf(\"%s: source rx not ready for H264 control\\n\", __func__);\n\n        return -1;\n\n    }\n\n  \n\n    memset(&p, 0xFF, sizeof(p));\n\n    if (req->intraPicRate != -1)\n\n        p.intraPicRate = req->intraPicRate;\n\n    // else\n\n    //  p.intraPicRate = HSVC_HND_H264_CTRL_MAX_GOP_FRAMES;\n\n    if (req->bitPerSecond != -1)\n\n        p.bitPerSecond = req->bitPerSecond;\n\n    if (req->qpMin != -1)\n\n        p.qpMin = req->qpMin;\n\n    if (req->qpMax != -1)\n\n        p.qpMax = req->qpMax;\n\n    if (req->qpHdr != -1)\n\n        p.qpHdr = req->qpHdr;\n\n    if (req->fixedIntraQp != -1)\n\n        p.fixedIntraQp = req->fixedIntraQp;\n\n  \n\n    printf(\"update enc para:bps=%d fixedIntraQp=%d,intraPicRate=%d\\n\", p.bitPerSecond, p.fixedIntraQp, p.intraPicRate);\n\n    ret = ioctl(*runtime->rx_fd, HDMI_RX_SET_H264_ENC_PARAM, &p);\n\n    if (ret == 0 && req->fixedIntraQp != -1)\n\n        ctrl->current_fixed_intra_qp = req->fixedIntraQp;\n\n    if (ret == 0 && req->bitPerSecond > 0) {\n\n        ctrl->current_bps = req->bitPerSecond;\n\n        if (reset_bitrate_window || !ctrl->adaptive_ready) {\n\n            ctrl->max_bps = req->bitPerSecond;\n\n            ctrl->min_bps = req->bitPerSecond / 4;\n\n            if (ctrl->min_bps < HSVC_HND_H264_CTRL_MIN_BITRATE)\n\n                ctrl->min_bps = HSVC_HND_H264_CTRL_MIN_BITRATE;\n\n            if (ctrl->min_bps > ctrl->max_bps)\n\n                ctrl->min_bps = ctrl->max_bps;\n\n            ctrl->adaptive_ready = true;\n\n        }\n\n    }\n\n  \n\n    return ret;\n\n}\n        \n        ","x":820,"y":-320,"width":1031,"height":660},
		{"id":"e46bab32da29cc97","type":"text","text":"编码参数设置","x":-140,"y":-40,"width":156,"height":60,"color":"1"},
		{"id":"e122d85589f1a7ec","type":"file","file":"音视频开发/02.编码.canvas","x":-1520,"y":-160,"width":400,"height":400},
		{"id":"899048fed6ad5b7f","type":"text","text":"video producer 线程\n\n","x":-236,"y":1560,"width":236,"height":50,"color":"1"},
		{"id":"57baf482b406f1ec","type":"text","text":"  -> 从 frame cache 取编码帧","x":349,"y":2454,"width":256,"height":50},
		{"id":"9fa114b6292c238e","type":"text","text":"\n  -> TCP/UDP/KCP 发给接收端","x":336,"y":2586,"width":281,"height":58},
		{"id":"a9c836449f75bed6","type":"text","text":"video sender 线程\n","x":-180,"y":2479,"width":214,"height":60,"color":"1"},
		{"id":"8a8b6696b37ba38d","type":"text","text":"-> 读编码后的 payload","x":506,"y":1600,"width":250,"height":60},
		{"id":"42b1c0aa2a666f40","type":"text","text":"  -> 填网络帧头","x":506,"y":1700,"width":250,"height":60},
		{"id":"adbfc4fbb343f815","type":"text","text":"  -> 放入 frame cache","x":506,"y":1900,"width":250,"height":60},
		{"id":"f90b46c034ecd222","type":"text","text":"JPEG 根据帧大小动态调质量\nif (runtime->enc_type == VIDENC_TYPE_JPEG)\n    jdo_change_quality(slot->header.size, runtime);","x":2226,"y":1760,"width":549,"height":126},
		{"id":"e8765a54119614bc","type":"text","text":"H264 如果发现 IDR 帧太大，就调整 QP，避免关键帧把网络打爆。\nif (runtime->enc_type == VIDENC_TYPE_H264 &&\n    source_slot_is_h264_idr(slot, runtime)) {\n    source_h264_adjust_idr_qp(runtime, idr_payload_size);\n}","x":2239,"y":1921,"width":536,"height":139},
		{"id":"32496f693f2ec35b","type":"text","text":"这一帧是 JPEG 还是 H264\n大小是多少\n分辨率是多少\n时间戳是多少\n帧序号是多少","x":1646,"y":1600,"width":299,"height":135},
		{"id":"dc4990d598be1523","type":"text","text":"先读 AvPktHd\n  -> 知道 payload 大小和 pts","x":1002,"y":1330,"width":404,"height":95},
		{"id":"507e9da80fa5225a","type":"text","text":"再读 payload\n  -> 得到真正 JPEG/H264 码流","x":1027,"y":1471,"width":354,"height":89},
		{"id":"36c3966aaf8760b9","type":"text","text":"  -> H264 做 IDR/QP/码率控制","x":496,"y":1800,"width":270,"height":60},
		{"id":"89fd45fb5a0f72b8","type":"text","text":"  -> 从 kshm 读 AvPktHd","x":506,"y":1500,"width":250,"height":60},
		{"id":"607538023612c127","type":"text","text":"1. 驱动丢帧\n   新编码出的帧写不进去，只能丢掉。\n\n2. 编码链路阻塞\n   如果驱动设计成阻塞模式，编码器/DMA 可能暂停等待空间。\n\n3. 延迟越来越大\n   如果缓冲队列不丢帧而是排队，应用再读到的就是很久以前的旧帧。\n\n4. 打印类似日志\n   之前代码注释里就提到：\n   \"video kshm is full, drop current frame\"","x":766,"y":530,"width":523,"height":310},
		{"id":"10cb54649e2a10a2","type":"text","text":"**环形缓冲区**","x":410,"y":990,"width":250,"height":60},
		{"id":"ba58c079d6c918d1","type":"text","text":"KSHM","x":200,"y":1023,"width":106,"height":55},
		{"id":"2a4a3a9ec5ed5e0c","type":"text","text":"KSHM 的空间有多大","x":410,"y":1078,"width":250,"height":60},
		{"id":"8ece8850a3bed660","type":"file","file":"音视频开发/source_video_development/Pasted image 20260611192333.png","x":833,"y":952,"width":388,"height":68},
		{"id":"2e81eb283337aa14","type":"text","text":"常见视频 KSHM：4 MB ~ 12 MB\n常见音频 KSHM：640 KB ~ 6 MB\n无线图传项目：大约视频 12 MB、音频 6 MB","x":816,"y":1078,"width":372,"height":82},
		{"id":"42c1752cb6fa35bb","type":"file","file":"音视频开发/06.TCP-UDP-KCP.canvas","x":-1032,"y":2234,"width":400,"height":400},
		{"id":"dcf4c1b14233f2fd","type":"text","text":"## 常见问题与调试方法","x":-4400,"y":3520,"width":304,"height":68},
		{"id":"ec91b0cc861035b3","type":"text","text":"###  JPEG 码流太大","x":-4960,"y":3930,"width":250,"height":60},
		{"id":"a343c44b5838aaa8","type":"text","text":"### 花屏","x":-4613,"y":3930,"width":93,"height":60},
		{"id":"86d746d9be187ad6","type":"text","text":"IDR 是否正常发送\n是否有丢包\n接收端是否正确识别 H264\nsource_h264_request_idr 是否生效","x":-4650,"y":4283,"width":402,"height":157},
		{"id":"cf5cb85d2b9cd7d4","type":"text","text":"### 画面卡顿","x":-4400,"y":3930,"width":132,"height":60},
